{
    "name": "psc-acme/monitor-user",
    "description": "Package monitor-user for psc-acme organization",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\MonitorUser\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0",
        "symfony/uid": "^7.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "webforge/object-asserter": "^2.0.0"
    },
    "minimum-stability": "dev",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}